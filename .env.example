# Endereço do backend da equipa (único serviço que o frontend pode chamar).
# O browser nunca chama APIs de dados (NASA POWER, MODIS, etc.) diretamente.
NEXT_PUBLIC_API_URL="http://localhost:4000"

# true  -> usa dados de exemplo de src/mocks/analise.v1.json (trabalhar sem backend)
# false -> chama o backend real em NEXT_PUBLIC_API_URL
NEXT_PUBLIC_USE_MOCK=false
